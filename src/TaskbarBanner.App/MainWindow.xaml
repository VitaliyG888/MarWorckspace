<Window x:Class="TaskbarBanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Banner - Diagnostics"
        Width="1000"
        Height="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="ToggleBannersButton"
                    Content="Hide banners"
                    Width="120"
                    Padding="6,2"
                    Click="OnToggleBanners" />
            <Button Content="Refresh"
                    Width="90"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    Click="OnRefresh" />
            <Button x:Name="SignInButton"
                    Content="Sign in"
                    Width="80"
                    Margin="12,0,0,0"
                    Padding="6,2"
                    Click="OnSignIn" />
            <Button x:Name="SignOutButton"
                    Content="Sign out"
                    Width="90"
                    Margin="8,0,0,0"
                    Padding="6,2"
                    Click="OnSignOut" />
            <TextBlock x:Name="FooterText"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#475569" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="System state (lock / power / activity)"
                      Margin="0,0,5,0"
                      Padding="4">
                <DockPanel>
                    <TextBlock x:Name="StateSummaryText"
                               DockPanel.Dock="Top"
                               Margin="4"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <ListBox x:Name="StateEventsList"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Detected taskbars / monitors"
                      Margin="5,0,0,0"
                      Padding="4">
                <TextBox x:Name="StatusText"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="10,6"
                Background="#F1F5F9"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ad:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#334155" />
                <TextBlock x:Name="AdDetailText"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#0F172A" />
                <Button x:Name="OpenWebsiteButton"
                        Content="Open website"
                        Width="110"
                        Margin="14,0,0,0"
                        Padding="6,2"
                        Visibility="Collapsed"
                        Click="OnOpenWebsite" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   TextWrapping="Wrap"
                   Foreground="#64748B"
                   Text="Banners appear next to the notification area of each visible taskbar (bottom/top docked). Clicking a banner brings this window to the foreground. The engine counts a verified minute only after 5 fully-eligible minutes (Idle > Priming > Counting); any lock/sleep/taskbar-hide/idle breach discards the epoch and re-primes. Ads rotate from the server (or cached offline); 'Open website' launches the advertiser page in the default browser." />
    </Grid>
</Window>
