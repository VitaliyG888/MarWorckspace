<Window x:Class="TaskbarBanner.App.Overlays.BannerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BannerOverlayWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="True"
        Width="180"
        Height="60">
    <Border x:Name="RootCard"
            Background="#F8FAFC"
            BorderBrush="#33000000"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    x:Name="LogoBadge"
                    Width="40"
                    Height="40"
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    Background="#1E293B"
                    CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="LogoTextBlock"
                               Text="AD"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image x:Name="LogoImage"
                           Margin="3"
                           Stretch="Uniform"
                           Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="9,0,7,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineTextBlock"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TaglineTextBlock"
                           FontSize="9"
                           Foreground="#64748B"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
